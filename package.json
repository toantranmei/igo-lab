{
  "name": "competence-lab",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cl/web dev",
    "build": "pnpm --filter @cl/web build",
    "start": "pnpm --filter @cl/web start",
    "worker": "pnpm --filter @cl/worker start",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @cl/web typecheck",
    "lint": "pnpm typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration --no-file-parallelism",
    "e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "anchor:eval": "tsx scripts/anchor-eval.ts",
    "anchor:label": "tsx scripts/anchor-label.ts",
    "compare:model": "tsx scripts/compare-model.ts",
    "verify:stability": "tsx scripts/verify-stability.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "fflate": "^0.8.3",
    "postgres": "^3.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.7"
  }
}
