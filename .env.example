# Copy to .env. Nothing here is a real secret; replace the passwords before deploying.

# --- Postgres (docker compose) ---
POSTGRES_PORT=5570
POSTGRES_OWNER_PASSWORD=cl_owner_dev
POSTGRES_APP_PASSWORD=cl_app_dev

# --- App (web + worker when run on the host) ---
DATABASE_URL=postgres://cl_app:cl_app_dev@127.0.0.1:5570/competence_lab
DATABASE_OWNER_URL=postgres://cl_owner:cl_owner_dev@127.0.0.1:5570/competence_lab
DATA_DIR=./data
WEB_PORT=3100

# No login yet: the single local actor gets these permissions (VIEW,OPERATE,APPROVE,BACKUP_ADMIN).
LOCAL_ACTOR_PERMISSIONS=VIEW,OPERATE,APPROVE,BACKUP_ADMIN

# --- Claude CLI (worker only) ---
# Path to the CLI. Tests point this at a fake executable.
CLAUDE_BIN=claude
# Only needed when the worker runs in Docker: paste the token printed by `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Do NOT set ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN for the worker: the CLI would prefer them.
AGENT_TIMEOUT_MS=180000
AGENT_MAX_PARALLEL=3
AGENT_MAX_CALLS_PER_RUN=400
AGENT_MAX_INPUT_CHARS=120000

# --- Upload limits (shown in the UI before uploading) ---
MAX_FILES=20
MAX_FILE_MB=10
MAX_CHARS_PER_DOC=60000
